+//! Bridge between a blueprint and an external student model.
+//!
+//! `export` writes every infoset of a blueprint as one fixed-width record:
+//! its card bucket, the action tokens on offer (found by replaying the
+//! infoset's history), the history tokens, how often blueprint self-play
+//! visited it, and the blueprint's probabilities. `import` reads those
+//! records back with a table of probabilities from a student and saves a
+//! strategy file the engine can seat like any blueprint.
+//!
+//! Record layout, little-endian, `width` actions and `hist` tokens wide:
+//! bucket u16, actions u8, tokens u8, action tokens [u8; width] (255 pad),
+//! history [u8; hist] (255 pad), visits u32, probabilities [f32; width].
+
+use crate::abstraction::{AbsAction, Abstraction, TOKEN_STREET_SEP};
+use crate::bot::Policy;
+use crate::cards::fresh_deck;
+use crate::cfr::{make_key, Blueprint, StrategyMap};
+use crate::engine::HandConfig;
+use crate::table::Table;
+use rand::rngs::SmallRng;
+use rand::seq::SliceRandom;
+use rand::{Rng, SeedableRng};
+use rayon::prelude::*;
+use std::collections::HashMap;
+use std::io::{Read, Write};
+
+const PAD: u8 = 255;
+const CHUNK: usize = 1 << 20;
+
+fn action_of(token: u8) -> AbsAction {
+    match token {
+        0 => AbsAction::Fold,
+        1 => AbsAction::CheckCall,
+        2 => AbsAction::AllIn,
+        t => AbsAction::Bet(t - 3),
+    }
+}
+
+/// The action tokens on offer after `hist`, or None when the history is not
+/// a line of play the abstraction can replay (leaf keys, menu drift).
+fn offered(hist: &[u8], cfg: &HandConfig, abs: &Abstraction) -> Option<Vec<u8>> {
+    let mut table = Table::new(cfg, 0, fresh_deck());
+    for &token in hist {
+        if token == TOKEN_STREET_SEP {
+            continue;
+        }
+        let action = action_of(token);
+        if table.real.is_terminal() || !abs.abstract_actions(&table.shadow).contains(&action) {
+            return None;
+        }
+        table.apply_abs(action, abs);
+    }
+    if table.real.is_terminal() || table.hist != hist {
+        return None;
+    }
+    Some(abs.abstract_actions(&table.shadow).iter().map(|a| a.token()).collect())
+}
+
+/// Visits per infoset key over `hands` hands. Without an actor every seat
+/// plays `policy` and every decision counts. With one, the actor takes a
+/// rotating seat among copies of `policy` and only its decisions count: the
+/// infosets a student reaches when it is seated with its teacher.
+fn visits(
+    policy: &Policy,
+    actor: Option<&Policy>,
+    cfg: &HandConfig,
+    hands: u64,
+    seed: u64,
+) -> HashMap<Vec<u8>, u32> {
+    let n = cfg.num_players;
+    (0..hands)
+        .into_par_iter()
+        .fold(HashMap::new, |mut seen: HashMap<Vec<u8>, u32>, i| {
+            let mut rng = SmallRng::seed_from_u64(seed ^ i.wrapping_mul(0x2545_F491_4F6C_DD1D));
+            let hero = (i % n as u64) as usize;
+            let button = rng.random_range(0..n);
+            let mut deck = fresh_deck();
+            deck.shuffle(&mut rng);
+            let mut table = Table::new(cfg, button, deck);
+            let mut guard = 0;
+            while !table.real.is_terminal() {
+                guard += 1;
+                assert!(guard < 500, "self-play hand did not terminate");
+                // One bucket draw decides both the visit and the move, exactly as
+                // `blueprint_dist` plays: an unseen or mismatched infoset checks or calls.
+                let p = table.shadow.to_act();
+                let seated = match actor {
+                    Some(a) if p == hero => a,
+                    _ => policy,
+                };
+                let counted = actor.is_none() || p == hero;
+                let bucket = policy.abs.bucket(table.shadow.hole(p), table.shadow.board(), &mut rng);
+                let acts = policy.abs.abstract_actions(&table.shadow);
+                let known = seated
+                    .blueprint
+                    .get(bucket, &table.hist)
+                    .filter(|s| s.len() == acts.len() && s.iter().sum::<f32>() > 0.0);
+                let a = match known {
+                    Some(s) => {
+                        if counted {
+                            *seen.entry(make_key(bucket, &table.hist).into_vec()).or_insert(0) += 1;
+                        }
+                        let mut left = rng.random::<f32>() * s.iter().sum::<f32>();
+                        let mut pick = acts.len() - 1;
+                        for (i, &pr) in s.iter().enumerate() {
+                            left -= pr;
+                            if left <= 0.0 {
+                                pick = i;
+                                break;
+                            }
+                        }
+                        acts[pick]
+                    }
+                    None => AbsAction::CheckCall,
+                };
+                table.apply_abs(a, &policy.abs);
+            }
+            seen
+        })
+        .reduce(HashMap::new, |mut a, b| {
+            for (k, v) in b {
+                *a.entry(k).or_insert(0) += v;
+            }
+            a
+        })
+}
+
+/// A blueprint's infosets in key order, so every export of one blueprint
+/// lists them identically and tables computed from one line up with another.
+fn ordered(strategies: &StrategyMap) -> Vec<(&Vec<u8>, &Vec<f32>)> {
+    let mut entries: Vec<(&Vec<u8>, &Vec<f32>)> = strategies.iter().collect();
+    entries.par_sort_unstable_by(|a, b| a.0.cmp(b.0));
+    entries
+}
+
+pub struct Exported {
+    pub records: u64,
+    pub skipped: u64,
+    pub visited: u64,
+    pub width: usize,
+    pub hist: usize,
+}
+
+pub fn export(policy: &Policy, hands: u64, seed: u64, out: &str) -> std::io::Result<Exported> {
+    let cfg = HandConfig {
+        num_players: policy.blueprint.num_players,
+        ..HandConfig::default()
+    };
+    let seen = visits(policy, None, &cfg, hands, seed);
+    let entries = ordered(&policy.blueprint.strategies);
+    let width = entries.iter().map(|(_, s)| s.len()).max().unwrap_or(0);
+    let hist = entries.iter().map(|(k, _)| k.len() - 2).max().unwrap_or(0);
+    let mut f = std::io::BufWriter::new(std::fs::File::create(out)?);
+    let mut done = Exported { records: 0, skipped: 0, visited: 0, width, hist };
+    for chunk in entries.chunks(CHUNK) {
+        let rows: Vec<Option<Vec<u8>>> = chunk
+            .par_iter()
+            .map(|(key, probs)| {
+                let acts = offered(&key[2..], &cfg, &policy.abs).filter(|a| a.len() == probs.len())?;
+                let mut row = Vec::with_capacity(8 + 5 * width + hist);
+                row.extend_from_slice(&key[..2]);
+                row.push(acts.len() as u8);
+                row.push((key.len() - 2) as u8);
+                row.extend_from_slice(&acts);
+                row.resize(4 + width, PAD);
+                row.extend_from_slice(&key[2..]);
+                row.resize(4 + width + hist, PAD);
+                let count = seen.get(*key).copied().unwrap_or(0);
+                row.extend_from_slice(&count.to_le_bytes());
+                for i in 0..width {
+                    row.extend_from_slice(&probs.get(i).copied().unwrap_or(0.0).to_le_bytes());
+                }
+                Some(row)
+            })
+            .collect();
+        for row in rows {
+            match row {
+                Some(row) => {
+                    if row[4 + width + hist..8 + width + hist] != [0u8; 4] {
+                        done.visited += 1;
+                    }
+                    f.write_all(&row)?;
+                    done.records += 1;
+                }
+                None => done.skipped += 1,
+            }
+        }
+    }
+    f.flush()?;
+    Ok(done)
+}
+
+/// Visits of `actor` seated with five copies of `policy`, one u32 per
+/// exported record of `policy`, in the records' order. Returns the records
+/// written and how many of them the actor reached.
+pub fn reach(policy: &Policy, actor: &Policy, hands: u64, seed: u64, out: &str) -> std::io::Result<(u64, u64)> {
+    let cfg = HandConfig {
+        num_players: policy.blueprint.num_players,
+        ..HandConfig::default()
+    };
+    let seen = visits(policy, Some(actor), &cfg, hands, seed);
+    let mut f = std::io::BufWriter::new(std::fs::File::create(out)?);
+    let (mut records, mut reached) = (0u64, 0u64);
+    for chunk in ordered(&policy.blueprint.strategies).chunks(CHUNK) {
+        let counts: Vec<Option<u32>> = chunk
+            .par_iter()
+            .map(|(key, probs)| {
+                offered(&key[2..], &cfg, &policy.abs).filter(|a| a.len() == probs.len())?;
+                Some(seen.get(*key).copied().unwrap_or(0))
+            })
+            .collect();
+        for count in counts.into_iter().flatten() {
+            f.write_all(&count.to_le_bytes())?;
+            records += 1;
+            reached += u64::from(count > 0);
+        }
+    }
+    f.flush()?;
+    Ok((records, reached))
+}
+
+/// Build a strategy file from exported records and a student's table of
+/// probabilities (f32, `width` per record, in the records' order). The card
+/// abstraction and table size are the teacher's.
+pub fn import(like: Blueprint, records: &str, probs: &str, width: usize, hist: usize) -> std::io::Result<Blueprint> {
+    let Blueprint { iterations, num_players, abs_cfg, centroids, strategies: teacher } = like;
+    drop(teacher);
+    let mut keys = std::io::BufReader::new(std::fs::File::open(records)?);
+    let mut table = std::io::BufReader::new(std::fs::File::open(probs)?);
+    let mut record = vec![0u8; 8 + 5 * width + hist];
+    let mut given = vec![0u8; 4 * width];
+    let mut strategies = StrategyMap::default();
+    while keys.read_exact(&mut record).is_ok() {
+        table.read_exact(&mut given)?;
+        let actions = record[2] as usize;
+        let tokens = record[3] as usize;
+        let mut key = record[..2].to_vec();
+        key.extend_from_slice(&record[4 + width..4 + width + tokens]);
+        let strat: Vec<f32> = (0..actions)
+            .map(|i| f32::from_le_bytes([given[4 * i], given[4 * i + 1], given[4 * i + 2], given[4 * i + 3]]))
+            .collect();
+        strategies.insert(key, strat);
+    }
+    Ok(Blueprint { strategies, iterations, num_players, abs_cfg, centroids })
+}
