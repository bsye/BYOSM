+//! Describe the decision a logged hand stops at, for an external student:
+//! who is to act, their card bucket, the history tokens, and the moves on
+//! offer with their chip amounts. Needs only the card abstraction, not a
+//! blueprint, so it starts in milliseconds.
+
+use crate::abstraction::{AbsAction, AbsConfig, Abstraction, Centroids};
+use crate::benchmark::{logged_action, parse_phh, seat_table};
+use crate::cards::parse_card;
+use crate::cfr::Blueprint;
+use crate::engine::{Hand, PlayerAction};
+use rand::rngs::SmallRng;
+use rand::SeedableRng;
+
+/// Save the part of a blueprint that maps cards to buckets.
+pub fn save_abstraction(bp: &Blueprint, out: &str) -> std::io::Result<()> {
+    let f = std::io::BufWriter::new(std::fs::File::create(out)?);
+    bincode::serialize_into(f, &(&bp.abs_cfg, &bp.centroids)).map_err(std::io::Error::other)
+}
+
+pub fn load_abstraction(path: &str) -> std::io::Result<Abstraction> {
+    let f = std::io::BufReader::new(std::fs::File::open(path)?);
+    let (cfg, centroids): (AbsConfig, Option<Centroids>) =
+        bincode::deserialize_from(f).map_err(std::io::Error::other)?;
+    Ok(Abstraction::with_centroids(cfg, centroids))
+}
+
+fn shown(actions: &[String], seat: usize) -> bool {
+    let dealt = format!("p{}", seat + 1);
+    actions.iter().any(|a| {
+        let w: Vec<&str> = a.split_whitespace().collect();
+        w.len() == 4
+            && w[0] == "d"
+            && w[1] == "dh"
+            && w[2] == dealt
+            && w[3].len() == 4
+            && parse_card(&w[3][0..2]).is_some()
+            && parse_card(&w[3][2..4]).is_some()
+    })
+}
+
+fn named(real: &Hand, abs: &Abstraction, a: AbsAction) -> String {
+    let passive = || {
+        if real.can_check() {
+            "check".to_string()
+        } else {
+            format!("call {}", real.to_call())
+        }
+    };
+    match a {
+        AbsAction::Fold => "fold".to_string(),
+        AbsAction::CheckCall => passive(),
+        _ if real.raise_bounds().is_none() => passive(),
+        _ => match abs.concrete(real, a) {
+            PlayerAction::RaiseTo(x) if a == AbsAction::AllIn => format!("all in for {x}"),
+            PlayerAction::RaiseTo(x) => format!("raise to {x}"),
+            _ => passive(),
+        },
+    }
+}
+
+pub fn describe(text: &str, abs: &Abstraction, seed: u64) -> Result<serde_json::Value, String> {
+    let phh = parse_phh(text).ok_or("this is not a no-limit hold'em hand history the engine reads")?;
+    let mut table = seat_table(&phh)
+        .map_err(|_| "the engine needs 2 to 6 players with equal starting stacks and no card dealt twice")?;
+    for line in &phh.actions {
+        let Some((seat, action)) = logged_action(line).map_err(|_| format!("cannot read the action '{line}'"))?
+        else {
+            continue;
+        };
+        if table.real.is_terminal() || table.real.to_act() != seat {
+            return Err(format!("the actions do not replay: '{line}' is out of turn"));
+        }
+        table.apply_concrete(action, abs);
+    }
+    if table.real.is_terminal() {
+        return Err("the hand is already over: stop the history at the decision".to_string());
+    }
+    let seat = table.real.to_act();
+    if !shown(&phh.actions, seat) {
+        return Err(format!(
+            "it is {}'s turn to act, and the history does not show their cards",
+            phh.players[seat]
+        ));
+    }
+    let mut rng = SmallRng::seed_from_u64(seed);
+    let bucket = abs.bucket(table.shadow.hole(seat), table.shadow.board(), &mut rng);
+    let acts = abs.abstract_actions(&table.shadow);
+    Ok(serde_json::json!({
+        "seat": seat + 1,
+        "player": phh.players[seat],
+        "street": format!("{:?}", table.real.street()),
+        "bucket": bucket,
+        "hist": table.hist,
+        "offered": acts.iter().map(|a| a.token()).collect::<Vec<u8>>(),
+        "moves": acts.iter().map(|&a| named(&table.real, abs, a)).collect::<Vec<String>>(),
+    }))
+}
