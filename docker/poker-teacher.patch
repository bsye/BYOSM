+/// One JSON line per recorded decision: the hand, the decision's order in it,
+/// the abstract actions offered, the blueprint's probabilities and the action taken.
+pub fn labels(dir: &str, policy: &Policy) -> std::io::Result<Vec<String>> {
+    let mut files = Vec::new();
+    collect_phh_files(std::path::Path::new(dir), &mut files)?;
+    files.sort();
+    let lines: Vec<Vec<String>> = files
+        .par_iter()
+        .enumerate()
+        .map(|(i, path)| {
+            let hand = format!(
+                "{}/{}",
+                path.parent().and_then(|p| p.file_name()).and_then(|n| n.to_str()).unwrap_or(""),
+                path.file_stem().and_then(|n| n.to_str()).unwrap_or("")
+            );
+            let Some(phh) = std::fs::read_to_string(path).ok().and_then(|t| parse_phh(&t)) else {
+                return Vec::new();
+            };
+            let Ok((decisions, _)) = replay_hand(&phh, policy, 0xBEEF ^ i as u64) else {
+                return Vec::new();
+            };
+            decisions
+                .iter()
+                .enumerate()
+                .map(|(k, d)| {
+                    serde_json::json!({
+                        "hand": hand,
+                        "index": k,
+                        "street": format!("{:?}", d.street),
+                        "actions": d.actions,
+                        "probs": d.probs,
+                        "taken": d.taken,
+                    })
+                    .to_string()
+                })
+                .collect()
+        })
+        .collect();
+    Ok(lines.into_iter().flatten().collect())
+}
